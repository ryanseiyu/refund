        <messages/>
        <name>Restrict State Choices for HR Resolver</name>
        <order/>
        <script><![CDATA[(function onLoad(current, gForm, gS, gUser) {
    // Check if the user has the specific role
    if (gUser.hasRole('x_1105246_refund.hr_resolver')) {
        // Get all available choices for the "State" field
        var stateChoices = gForm.getField('state').choices;

        // Remove choices that are not "Awaiting Payment" (e.g., 3) or "Closed Complete" (e.g., 5)
        for (var i = 0; i < stateChoices.length; i++) {
            var choice = stateChoices[i];
            if (choice.value != '3' && choice.value != '5') { // Replace with your actual values
                gForm.removeOption('state', choice.value);
            }
        }
    }
})(current, gForm, gS, gUser);
]]></script>
