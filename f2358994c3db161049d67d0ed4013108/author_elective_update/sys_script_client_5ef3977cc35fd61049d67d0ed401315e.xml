        <field>expense_date</field>
        <global>true</global>
        <isolate_script>true</isolate_script>
        <messages/>
        <name>Validate Expense Date</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
    if (isLoading || newValue === '') {
        return; // Não faça nada ao carregar ou se a variável estiver vazia
    }

    // Obter a data atual sem a parte do tempo
    var today = new Date();
    today.setHours(0, 0, 0, 0); // Define para a data atual sem a parte do tempo

    // Converter a data de despesa para um objeto Date
    var expenseDate = new Date(newValue);

    // Verificar se a data da despesa é maior que a data atual
    if (expenseDate > today) {
        // Exibir uma mensagem de erro ao usuário
        g_form.showFieldMsg('expense_date', 'A data de despesa não pode estar no futuro.', 'error');

        // Limpar o valor da variável para forçar o usuário a corrigir
        g_form.setValue('expense_date', '');
    } else {
        // Remover qualquer mensagem de erro se a validação for bem-sucedida
        g_form.hideFieldMsg('expense_date');
    }
}
]]></script>
