        <name>Restrict State Choices for HR Resolver</name>
        <order/>
        <script><![CDATA[(function onLoad(current, gForm, gUser) {
    // Check if the user has the specific role
	
    // if (gUser.hasRole('c3358994c3db161049d67d0ed401315e')) {
        // Inform the user about the restriction
        gForm.addInfoMessage('You can only select "Awaiting Payment" or "Closed Complete" in the State field.');

        // Allowed State values for HR Resolver role
        var allowedStates = ['3', '5']; // Replace with the actual values for "Awaiting Payment" and "Closed Complete"

        // Get all available choices for the "State" field
        var stateChoices = gForm.getField('state').choices;

        // Loop through all choices and remove those not allowed
        for (var i = 0; i < stateChoices.length; i++) {
            var choice = stateChoices[i];
            if (!allowedStates.includes(choice.value)) {
                gForm.removeOption('state', choice.value);
            }
        }
    // }
})(current, gForm, gUser);
]]></script>
